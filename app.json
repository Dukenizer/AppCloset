{
  "expo": {
    "name": "ArtCloset",
    "slug": "ArtCloset",
    "scheme": "artcloset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.dukenizer.artcloset",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "ArtCloset uses the camera only when you choose to photograph artwork.",
        "NSPhotoLibraryUsageDescription": "ArtCloset accesses your library only when you choose artwork images.",
        "NSPhotoLibraryAddUsageDescription": "ArtCloset can save exported artwork cards when you request it."
      }
    },
    "android": {
      "package": "com.dukenizer.artcloset",
      "versionCode": 1,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "headers": {
            "Cross-Origin-Embedder-Policy": "credentialless",
            "Cross-Origin-Opener-Policy": "same-origin"
          }
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ArtCloset to photograph your artwork.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow ArtCloset to select artwork images.",
          "microphonePermission": false,
          "colors": {
            "cropToolbarColor": "#141210",
            "cropToolbarIconColor": "#F0EBE3",
            "cropToolbarActionTextColor": "#B8935A",
            "cropBackButtonIconColor": "#F0EBE3",
            "cropBackgroundColor": "#141210"
          },
          "dark": {
            "colors": {
              "cropToolbarColor": "#141210",
              "cropToolbarIconColor": "#F0EBE3",
              "cropToolbarActionTextColor": "#B8935A",
              "cropBackButtonIconColor": "#F0EBE3",
              "cropBackgroundColor": "#141210"
            }
          }
        }
      ],
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true,
          "faceIDPermission": "Allow ArtCloset to protect backup credentials."
        }
      ],
      "expo-web-browser",
      "expo-mail-composer",
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
