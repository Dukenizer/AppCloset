# Copy to .env (gitignored). Required for VIP redeem and EAS builds.
# Use the SAME salt when running: npm run generate:vip-hashes
ARTCLOSET_VIP_SALT=

# Google Drive native Sign-In (Android preview/dev builds). Leave empty to hide Drive connect.
# Use the Android OAuth client ID (package + SHA-1), not a Web client.
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
